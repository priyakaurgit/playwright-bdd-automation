{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["DOM", "ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowJs": false,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "playwright", "playwright-bdd"]
  },
  "include": ["pages", "steps", "features", "utils", "tests", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
